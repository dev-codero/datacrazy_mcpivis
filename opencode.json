{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "spec-workflow": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@pimzino/spec-workflow-mcp@latest",
        "."
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false",
        "--enable-gui-log-window",
        "false"
      ],
      "enabled": true
    },
    "qdrant-memory": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-qdrant"
      ],
      "environment": {
        "QDRANT_URL": "qdrant.workdodev.com",
        "QDRANT_API_KEY": "${QDRANT_API_KEY}",
        "COLLECTION_NAME": "agent_datacrazy_mcpivis",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "enabled": true
    }
  }
}
